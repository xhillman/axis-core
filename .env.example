# Axis Core Environment Variables
# Copy this file to .env and uncomment values you want to set.

# =============================================================================
# Config Singleton Defaults (loaded by axis_core.config.Config)
# =============================================================================

# Default model when Agent(model=...) is omitted
# AXIS_DEFAULT_MODEL=claude-sonnet-4-20250514

# Default memory adapter when Agent(memory=...) is omitted
# AXIS_DEFAULT_MEMORY=ephemeral

# Default planner when Agent(planner=...) is omitted
# AXIS_DEFAULT_PLANNER=auto

# Provider API keys (used by model adapters when api_key is not passed)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Global config flags exposed on axis_core.config.config
# AXIS_TELEMETRY=true
# AXIS_VERBOSE=false
# AXIS_DEBUG=false

# =============================================================================
# Runtime Variables (read directly by runtime code)
# =============================================================================

# Transcript and context assembly controls
# AXIS_TRANSCRIPT_STRICT=false
# AXIS_MAX_TOOL_RESULT_CHARS=20000
# AXIS_CONTEXT_STRATEGY=smart
# AXIS_MAX_CYCLE_CONTEXT=5
# AXIS_CONTEXT_GUARD_ENABLED=false
# AXIS_CONTEXT_WINDOW_TOKENS=128000
# AXIS_CONTEXT_GUARD_WARN_TOKENS=32000
# AXIS_CONTEXT_GUARD_BLOCK_TOKENS=16000
# AXIS_CONTEXT_PRUNE_ENABLED=false

# Telemetry sink controls (used when telemetry sinks are env-resolved)
# AXIS_TELEMETRY_SINK=none
# AXIS_TELEMETRY_REDACT=true
# AXIS_TELEMETRY_COMPACT=false
# AXIS_TELEMETRY_FILE=./axis_trace.jsonl
# AXIS_TELEMETRY_CALLBACK=my_app.telemetry:handle_event
# AXIS_TELEMETRY_BUFFER_MODE=batched
# AXIS_TELEMETRY_BATCH_SIZE=100

# Persist sensitive tool data in serialized RunState (debug-only)
# AXIS_PERSIST_SENSITIVE_TOOL_DATA=false

# Synaptic memory adapter default path
# AXIS_SYNAPTIC_PATH=./synaptic.db

# =============================================================================
# Provider SDK Passthrough (not read by axis-core directly)
# =============================================================================

# OpenAI SDK endpoint override (for OpenRouter/openai-compatible gateways)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
